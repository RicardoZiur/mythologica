# Copia este archivo y renombralo a ".env" (sin el .example)
# El archivo .env NUNCA se sube a git ni se comparte: ahi van tus datos sensibles.

# Datos de conexion a MySQL (los valores por defecto de XAMPP son estos)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mitologia_griega

# Puerto donde va a correr tu servidor Node (distinto al de Apache/XAMPP que usa 80)
PORT=3001

# Secreto usado para firmar los tokens de sesion (JWT). Genera el tuyo
# con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_largo

# Datos SMTP para mandar los correos de verdad (verificacion de cuenta,
# recuperacion de contraseña). Mientras SMTP_HOST este vacio, estos
# correos NO se mandan: solo se imprimen en la consola del backend (ver
# utils/email.js) -- util para probar el flujo en desarrollo sin una
# cuenta de correo real, pero en produccion hay que completar esto para
# que a los usuarios les llegue el correo de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mythologica <no-reply@mythologica.cl>
